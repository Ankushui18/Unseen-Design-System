{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:design": "node scripts/design-lint.mjs",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "audit:components": "node scripts/component-audit.mjs",
    "quality:report": "node scripts/quality-check.mjs",
    "quality:check": "node scripts/quality-check.mjs --check",
    "quality:ia": "node scripts/quality-check.mjs --ia",
    "audit:variants": "node scripts/variant-audit.mjs --baseline audit/variant-audit-baseline.json",
    "tokens:export": "node scripts/tokens-export.mjs",
    "tokens:check": "node scripts/tokens-export.mjs --check",
    "test": "npm run test:types && npm run test:unit && npm run build && npm run lint:design && npm run quality:check && npm run test:smoke && npm run test:a11y",
    "test:browser": "npm run build && playwright test",
    "test:browser:update": "npm run build && playwright test visual --update-snapshots"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-live": "^4.1.8",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.1"
  }
}
